{
  "name": "fangyi-room-show",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:all": "npm --prefix app install && npm --prefix server install",
    "build": "npm --prefix app run build",
    "make:portable": "powershell -ExecutionPolicy Bypass -File ./make-portable-kit.ps1",
    "start": "npm --prefix server start",
    "start:one-click": "powershell -ExecutionPolicy Bypass -File ./start-one-click.ps1",
    "start:show": "npm --prefix app run build && npm --prefix server start",
    "dev:app": "npm --prefix app run dev -- --host 0.0.0.0 --port 5173",
    "dev:server": "npm --prefix server run dev"
  }
}
